EDGE_TARGET=vps-spaceship-01
MARKET_EDGE_NETWORK=nilx-edge
DOCKER_SOCKET_PROXY_IMAGE=ghcr.io/tecnativa/docker-socket-proxy:0.4.2
INFRABOT_CREDENTIALS_DIR=/opt/infrabot/credentials

TELEGRAM_BOT_TOKEN=
